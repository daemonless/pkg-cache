#!/bin/sh
# Render the Linux repository locations (apt, dnf, apk, pacman) the server
# block includes, and repos.json for the landing page. A family that is off
# still gets its locations: a 404 that says how to turn it on, instead of
# falling through to the FreeBSD mirror and caching its 404.
#
# Usage: pkg-cache-repos <nginx include> <repos.json>

CONF="$1"
JSON="$2"

invalid_env() {
    echo "[pkg-cache] invalid $1: $2" >&2
    exit 1
}

# on VAR: the toggle's value, true or false; anything else stops the start.
on() {
    eval "v=\${$1:-false}"
    case "$v" in
        true|false) echo "$v" ;;
        *) invalid_env "$1" "$v" ;;
    esac
}

# base VAR DEFAULT: an upstream URL base, http(s)://host[:port][/path], no
# trailing slash.
base() {
    eval "v=\${$1:-$2}"
    v="${v%/}"
    printf "%s" "$v" | grep -Eq '^https?://[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?(:[0-9]+)?(/[A-Za-z0-9._~/-]*)?$' \
        || invalid_env "$1" "$v"
    echo "$v"
}

APT=$(on PKG_CACHE_APT) || exit 1
DNF=$(on PKG_CACHE_DNF) || exit 1
APK=$(on PKG_CACHE_APK) || exit 1
PACMAN=$(on PKG_CACHE_PACMAN) || exit 1

DEBIAN=$(base PKG_DEBIAN_UPSTREAM https://deb.debian.org/debian) || exit 1
DEBIAN_SECURITY=$(base PKG_DEBIAN_SECURITY_UPSTREAM https://deb.debian.org/debian-security) || exit 1
UBUNTU=$(base PKG_UBUNTU_UPSTREAM https://archive.ubuntu.com/ubuntu) || exit 1
UBUNTU_SECURITY=$(base PKG_UBUNTU_SECURITY_UPSTREAM https://security.ubuntu.com/ubuntu) || exit 1
UBUNTU_PORTS=$(base PKG_UBUNTU_PORTS_UPSTREAM https://ports.ubuntu.com/ubuntu-ports) || exit 1
FEDORA=$(base PKG_FEDORA_UPSTREAM https://dl.fedoraproject.org/pub/fedora/linux) || exit 1
EPEL=$(base PKG_EPEL_UPSTREAM https://dl.fedoraproject.org/pub/epel) || exit 1
ALPINE=$(base PKG_ALPINE_UPSTREAM https://dl-cdn.alpinelinux.org/alpine) || exit 1
ARCH=$(base PKG_ARCH_UPSTREAM https://geo.mirror.pkgbuild.com) || exit 1

# One nested location: a TTL for the paths it matches. rewrite and
# proxy_pass are not inherited into nested locations, so each repeats them.
# The variable in proxy_pass makes nginx resolve at request time, so it
# starts even when the upstream does not resolve yet.
ttl() {
    cat <<EOF
        location ~ $1 {
            proxy_cache_valid 200 $2;
            rewrite ^$PREFIX(.*)\$ $UPATH/\$1 break;
            proxy_pass $USCHEME://$UHOST\$uri\$is_args\$args;
        }
EOF
}

# repo PREFIX URL VAR STATE: one /prefix/ -> upstream mapping. The rest of
# the arguments come in as RULES, "regex ttl" per line, most specific first.
repo() {
    PREFIX="$1" URL="$2" VAR="$3" STATE="$4"
    if [ "$STATE" != true ]; then
        cat <<EOF
    location ^~ $PREFIX {
        default_type text/plain;
        return 404 "This pkg-cache does not cache $FAMILY repositories. Turn them on with $VAR=true.\n";
    }

EOF
        return
    fi
    USCHEME="${URL%%://*}"
    rest="${URL#*://}"
    UHOST="${rest%%/*}"
    UPATH=""
    [ "$rest" != "$UHOST" ] && UPATH="/${rest#*/}"
    UNAME="${UHOST%%:*}"
    cat <<EOF
    location ^~ $PREFIX {
        proxy_set_header Host $UHOST;
        proxy_ssl_name $UNAME;
        proxy_cache_key "$URL\$request_uri";
EOF
    echo "$RULES" | while read -r re t; do
        [ -n "$re" ] && ttl "$re" "$t"
    done
    cat <<EOF
        location ~ . {
            proxy_cache_valid 200 10m;
            rewrite ^$PREFIX(.*)\$ $UPATH/\$1 break;
            proxy_pass $USCHEME://$UHOST\$uri\$is_args\$args;
        }
    }

EOF
}

{
    echo "# Generated by pkg-cache-repos at startup; edit the env, not this file."

    # apt: pool files and by-hash indexes are immutable; Release files and
    # the indexes they list change with every mirror push.
    FAMILY=apt
    RULES='/by-hash/ 365d
/dists/ 1m
\.(deb|udeb|dsc|diff\.gz|tar\.[a-z0-9]+)$ 365d'
    repo /debian/ "$DEBIAN" PKG_CACHE_APT "$APT"
    repo /debian-security/ "$DEBIAN_SECURITY" PKG_CACHE_APT "$APT"
    repo /ubuntu/ "$UBUNTU" PKG_CACHE_APT "$APT"
    repo /ubuntu-security/ "$UBUNTU_SECURITY" PKG_CACHE_APT "$APT"
    repo /ubuntu-ports/ "$UBUNTU_PORTS" PKG_CACHE_APT "$APT"

    # dnf: repomd.xml names the rest of repodata by checksum, so only it
    # goes stale.
    FAMILY=dnf
    RULES='/repodata/repomd\.xml(\.asc)?$ 1m
/repodata/ 365d
\.rpm$ 365d'
    repo /fedora/ "$FEDORA" PKG_CACHE_DNF "$DNF"
    repo /epel/ "$EPEL" PKG_CACHE_DNF "$DNF"

    FAMILY=apk
    RULES='/APKINDEX\.tar\.gz$ 1m
\.apk$ 365d'
    repo /alpine/ "$ALPINE" PKG_CACHE_APK "$APK"

    FAMILY=pacman
    RULES='\.(db|files)(\.tar\.[a-z0-9]+)?(\.sig)?$ 1m
\.pkg\.tar\.[a-z0-9]+(\.sig)?$ 365d'
    repo /archlinux/ "$ARCH" PKG_CACHE_PACMAN "$PACMAN"
} > "$CONF"

cat > "$JSON" <<EOF
{"freebsd":true,"apt":$APT,"dnf":$DNF,"apk":$APK,"pacman":$PACMAN}
EOF

echo "[pkg-cache] repos: freebsd apt=$APT dnf=$DNF apk=$APK pacman=$PACMAN"
